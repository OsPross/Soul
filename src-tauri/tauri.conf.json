{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soul",
  "version": "../package.json",
  "identifier": "com.oskar.soul",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "island",
        "title": "Soul Island",
        "url": "index.html",
        "width": 220,
        "height": 40,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "overlay",
        "title": "Soul",
        "url": "index.html",
        "width": 280,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "focus": false
      },
      {
        "label": "agent-highlight",
        "title": "Soul highlight",
        "url": "index.html",
        "width": 64,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Soul Settings",
        "url": "index.html",
        "width": 920,
        "height": 660,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "OsPross",
    "copyright": "© 2026 OsPross",
    "category": "Productivity",
    "shortDescription": "Voice AI desktop assistant",
    "longDescription": "Soul — voice AI desktop assistant with a Dynamic Island, push-to-talk dictation, Circle-to-Ask and voice commands, powered by the Gemini API.",
    "homepage": "https://github.com/OsPross/Soul",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Polish"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "alsa-lib",
          "libayatana-appindicator-gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFOUVFRTI3QzY5NERCMkQKUldRdDI1VEdKKzZlemlCTTA1VEJTU20wSEwxL3lFMkZOSzF3cWo3cnhuSUZkQk9rcDlRbGhrZk4K",
      "endpoints": [
        "https://github.com/OsPross/Soul/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
