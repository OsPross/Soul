{
  "_comment": "Mock Vio automation API (src-tauri/src/agent/computer/vio_mock.rs). `script` = the model's function calls in `cargo test` (the harness uses the real model instead). Refs carry the page generation: navigation or `expireOnce` makes old refs fail with 'ref expired'.",
  "token": "mock-token-5f1c",
  "tabs": [
    {
      "tabId": "tab-a1",
      "asleep": true,
      "title": "Formularz zgłoszeniowy",
      "url": "https://example.com/zgloszenie",
      "active": true,
      "text": "Formularz zgłoszeniowy. Podaj imię, e-mail i miasto, zaznacz zgody i kliknij Wyślij. Zgłoszenia przyjmujemy do piątku.",
      "elements": [
        { "ref": "e1", "role": "textbox", "tag": "input", "type": "text", "label": "Imię", "name": "imie", "placeholder": "", "value": "Oskar", "empty": false },
        { "ref": "e2", "role": "textbox", "tag": "input", "type": "email", "label": "E-mail", "name": "email", "placeholder": "jan@example.com", "value": "", "empty": true },
        { "ref": "e3", "role": "textbox", "tag": "input", "type": "text", "label": "Miasto", "name": "miasto", "placeholder": "", "value": "", "empty": true },
        { "ref": "e4", "role": "textbox", "tag": "input", "type": "password", "label": "Hasło", "name": "haslo", "placeholder": "", "value": "", "empty": true },
        { "ref": "e5", "role": "checkbox", "tag": "input", "type": "checkbox", "label": "Newsletter", "name": "newsletter", "placeholder": "", "value": "", "empty": false, "checked": false },
        { "ref": "e6", "role": "button", "tag": "button", "type": "submit", "label": "Wyślij", "name": "", "placeholder": "", "value": "", "empty": false },
        { "ref": "e7", "role": "button", "tag": "button", "type": "button", "label": "Dalej", "name": "", "placeholder": "", "value": "", "empty": false, "expireOnce": true },
        { "ref": "e8", "role": "textbox", "tag": "input", "type": "time", "label": "Godzina dostawy", "name": "godzina", "placeholder": "", "value": "", "empty": true },
        { "ref": "e9", "role": "combobox", "tag": "select", "type": "", "label": "Rozmiar", "name": "rozmiar", "placeholder": "", "value": "M", "empty": false,
          "options": [{ "value": "s", "label": "S", "selected": false }, { "value": "m", "label": "M", "selected": true }, { "value": "l", "label": "L", "selected": false }, { "value": "xl", "label": "XL", "selected": false }] },
        { "ref": "e10", "role": "textbox", "tag": "textarea", "type": "", "label": "Uwagi", "name": "uwagi", "placeholder": "", "value": "", "empty": true, "belowFold": true },
        { "ref": "e11", "role": "checkbox", "tag": "input", "type": "checkbox", "label": "Regulamin", "name": "regulamin", "placeholder": "", "value": "", "empty": false, "checked": false, "belowFold": true }
      ]
    },
    {
      "tabId": "tab-p2",
      "title": "Okno prywatne",
      "url": "https://example.org/private",
      "active": false,
      "forbidden": true,
      "text": "",
      "elements": []
    }
  ],
  "cases": [
    {
      "id": "vio_auth_failure",
      "task": "przeczytaj tę stronę w przeglądarce",
      "token": "wrong-token",
      "expect_auth_error": true
    },
    {
      "id": "vio_forbidden",
      "task": "przeczytaj tę stronę",
      "active_tab": "tab-p2",
      "script": [],
      "expect_error": "forbidden"
    },
    {
      "id": "vio_expired_ref",
      "task": "kliknij Dalej",
      "script": [["browser_click", { "id": 7, "final": true }]],
      "expect": { "clicked": ["Dalej"] }
    },
    {
      "id": "vio_empty_fields",
      "task": "sprawdź które pola są puste",
      "script": [["done", { "summary": "Puste są pola E-mail, Miasto i Hasło." }]],
      "expect_prompt": ["\"E-mail\" empty", "\"Miasto\" empty", "\"Hasło\" password empty"],
      "expect_summary": ["E-mail", "Miasto"]
    },
    {
      "id": "vio_fill_polish",
      "task": "wypełnij formularz: miasto Łódź",
      "script": [["browser_fill", { "id": 3, "text": "Łódź", "final": true }]],
      "expect": { "values": { "Miasto": "Łódź" } }
    },
    {
      "id": "vio_read_page",
      "task": "streść tę stronę",
      "script": [["browser_read_page", {}], ["done", { "summary": "To formularz zgłoszeniowy, zgłoszenia przyjmowane są do piątku." }]],
      "expect_summary": ["piątk"]
    },
    {
      "id": "vio_send_needs_confirm",
      "task": "kliknij Wyślij w formularzu na stronie",
      "confirm": "deny",
      "script": [["browser_click", { "id": 6, "final": true }]],
      "expect_confirm": true,
      "expect": { "not_clicked": ["Wyślij"] }
    },
    {
      "id": "vio_password_refused",
      "task": "wpisz hasło tajne123 w pole Hasło",
      "script": [["browser_fill", { "id": 4, "text": "tajne123" }]],
      "expect_error": true,
      "expect": { "values": { "Hasło": "" } }
    },
    {
      "id": "vio_time_and_select_via_fill",
      "task": "wypełnij formularz: godzina 12:00, rozmiar L, miasto Łódź",
      "script": [
        ["browser_fill", { "id": 8, "text": "12:00" }],
        ["browser_fill", { "id": 9, "text": "l" }],
        ["browser_fill", { "id": 3, "text": "Łódź", "final": true }]
      ],
      "expect": { "values": { "Miasto": "Łódź", "Godzina dostawy": "12:00", "Rozmiar": "L" } },
      "expect_prompt": ["type=time", "type=select options=\"S|M|L|XL\""]
    },
    {
      "id": "vio_invalid_time_is_a_note",
      "task": "ustaw godzinę dostawy na dwunastą i miasto Łódź",
      "script": [
        ["browser_fill", { "id": 8, "text": "dwunasta" }],
        ["browser_fill", { "id": 3, "text": "Łódź", "final": true }]
      ],
      "expect": { "values": { "Miasto": "Łódź", "Godzina dostawy": "" } },
      "expect_prompt": ["NOT filled", "HH:MM"]
    },
    {
      "id": "vio_select_option",
      "task": "wybierz rozmiar XL",
      "script": [["browser_select", { "id": 9, "option": "xl", "final": true }]],
      "expect": { "values": { "Rozmiar": "XL" } }
    },
    {
      "id": "vio_select_unknown_option_is_reported",
      "task": "wybierz rozmiar XXL",
      "script": [["browser_select", { "id": 9, "option": "XXL" }], ["done", { "summary": "Nie ma rozmiaru XXL." }]],
      "expect": { "values": { "Rozmiar": "M" } },
      "expect_prompt": ["no such option"]
    },
    {
      "id": "vio_fill_many_whole_form",
      "task": "wypełnij formularz: imię Anna, e-mail anna@example.com, miasto Łódź, godzina 18:30, rozmiar L, newsletter tak, uwagi dzwonić domofonem, zaakceptuj regulamin",
      "script": [
        ["browser_fill_many", { "fields": [
          { "id": 1, "text": "Anna" },
          { "id": 2, "text": "anna@example.com" },
          { "id": 3, "text": "Łódź" },
          { "id": 8, "text": "18:30" },
          { "id": 9, "option": "L" },
          { "id": 5, "checked": true },
          { "id": 10, "text": "dzwonić domofonem" },
          { "id": 11, "checked": true }
        ], "final": true }]
      ],
      "expect": { "values": { "Imię": "Anna", "E-mail": "anna@example.com", "Miasto": "Łódź", "Godzina dostawy": "18:30", "Rozmiar": "L", "Uwagi": "dzwonić domofonem" },
                  "checked": { "Newsletter": true, "Regulamin": true } },
      "expect_prompt": ["\"Uwagi\" empty offscreen", "offscreen"]
    },
    {
      "id": "vio_fill_many_reports_failures_and_goes_on",
      "task": "wypełnij formularz: godzina dwunasta, rozmiar XXL, miasto Łódź",
      "script": [
        ["browser_fill_many", { "fields": [
          { "id": 8, "text": "dwunasta" },
          { "id": 9, "option": "XXL" },
          { "id": 3, "text": "Łódź" }
        ] }],
        ["done", { "summary": "Wpisałem miasto; godzina i rozmiar się nie udały." }]
      ],
      "expect": { "values": { "Miasto": "Łódź", "Godzina dostawy": "", "Rozmiar": "M" } },
      "expect_prompt": ["1/3 fields set", "NOT set", "FAILED"]
    },
    {
      "id": "vio_fill_many_refuses_passwords",
      "task": "wypełnij formularz: imię Anna i hasło tajne123",
      "script": [["browser_fill_many", { "fields": [{ "id": 1, "text": "Anna" }, { "id": 4, "text": "tajne123" }] }]],
      "expect_error": true,
      "expect": { "values": { "Imię": "Oskar", "Hasło": "" } }
    },
    {
      "id": "vio_read_page_is_planned_locally",
      "task": "streść mi tę stronę",
      "script": [["done", { "summary": "Formularz zgłoszeniowy, zgłoszenia do piątku." }]],
      "expect_summary": ["piątk"],
      "expect_prompt": ["Zgłoszenia przyjmujemy do piątku"]
    },
    {
      "id": "vio_repeated_call_is_not_run_again",
      "task": "sprawdź które pola są puste",
      "script": [
        ["browser_list_tabs", {}],
        ["browser_list_tabs", {}],
        ["browser_list_tabs", {}],
        ["done", { "summary": "Puste są E-mail i Miasto." }]
      ],
      "expect_summary": ["E-mail"],
      "expect_prompt": ["identical to the previous call"]
    },
    {
      "id": "vio_open_url",
      "task": "otwórz example.com/nowa w przeglądarce",
      "script": [["open_url", { "url": "example.com/nowa", "final": true }]],
      "expect": { "opened": ["https://example.com/nowa"] }
    }
  ]
}
